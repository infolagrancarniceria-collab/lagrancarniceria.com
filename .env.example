# Postgres compartido con el POS — al conectar una base "Postgres" desde la
# pestaña Storage de Vercel, estas variables (o el nombre que Vercel les dé,
# ej. POSTGRES_PRISMA_URL) se agregan solas al proyecto. En desarrollo local,
# pega acá la connection string que te muestre Vercel.
DATABASE_URL=

# Llave que el POS manda en el header "x-sync-key" al llamar /api/sync/*.
# Generar una llave larga al azar (ej. `openssl rand -hex 32`) y copiarla
# también al .env del POS (WEB_SYNC_URL / SYNC_API_KEY) — no es la
# contraseña de la base de datos, así que puede rotarse sin tocar Postgres.
SYNC_API_KEY=
