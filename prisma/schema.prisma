// Base de datos compartida entre la página web y el POS (lagrancarniceria-pos).
// La web es la ÚNICA pieza que toca esta base de datos directamente — el POS
// nunca se conecta acá, le habla por HTTPS a las rutas /api/sync/* de la web
// (ver src/app/api/sync/), autenticado con SYNC_API_KEY. Así, si algún día
// esa llave se filtra desde el instalador del POS, el daño posible queda
// acotado a "puede escribir catálogo/leer pedidos", nunca a la base completa.
//
// Cada sync del POS reemplaza el catálogo entero (no hace diffs) — ver
// src/app/api/sync/catalogo/route.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id     Int    @id @default(autoincrement())
  // Id del producto en el POS (Producto.id de lagrancarniceria-pos) — único
  // porque cada sync reemplaza el catálogo completo por idPos.
  idPos  Int    @unique
  plu    String
  descripcion     String
  nombreCorto     String?
  categoriaNombre String
  marca           String?
  descripcionCorta String?

  precio Float
  // "kg" (productos pesables/importe) | "unidad" (productos normales) —
  // mismo criterio que ya usa el POS (ver Producto.precio en su schema).
  unidad String

  // Familia para el selector de corte (ej. "Vacuno", "Cerdo") — null si el
  // producto no muestra selector de corte. Las opciones válidas de cada
  // familia viven en CorteOpcion.
  familiaCorte String?

  // "disponible" | "agotado" | "proximamente" — string en vez de un enum de
  // Postgres para no tener que migrar el enum cada vez que el POS agregue
  // un estado nuevo (mismo criterio que usa el POS para sus campos libres).
  disponibilidad String  @default("disponible")
  featured        Boolean @default(false)
  lowStock        Boolean @default(false)

  // Promoción por volumen (ej. "$3.980/kg al llevar 3 kilos o más") — los
  // tres campos van juntos: si promoPrecioUnitario tiene valor, la tarjeta
  // de producto muestra el badge "Oferta" y la etiqueta.
  promoPrecioUnitario Float?
  promoGramosMinimos  Int?
  promoEtiqueta       String?

  actualizadoEn DateTime @updatedAt
}

model Comuna {
  id         Int    @id @default(autoincrement())
  nombre     String @unique
  costoEnvio Float

  actualizadoEn DateTime @updatedAt
}

model CorteOpcion {
  id      Int    @id @default(autoincrement())
  familia String
  nombre  String
  orden   Int    @default(0)

  @@unique([familia, nombre])
}

// Pedido armado por un cliente en la web (cotización, no un pago) — el POS
// lo trae mediante /api/sync/pedidos-pendientes y lo marca "entregadoAlPos"
// al confirmar que quedó guardado ahí (ver /api/sync/pedidos-confirmar),
// para no reenviarlo de nuevo.
model Pedido {
  id    String   @id @default(cuid())
  fecha DateTime @default(now())

  clienteNombre   String
  clienteTelefono String

  // "retiro" | "despacho" — clienteDireccion/comunaNombre/costoEnvio solo
  // aplican (y son obligatorios en la validación de /api/pedidos) cuando es
  // despacho; en un retiro en tienda quedan null. El default solo importa
  // para la migración (filas existentes, si las hubiera) — todo pedido
  // nuevo siempre lo manda explícito.
  tipoEntrega      String  @default("despacho")
  clienteDireccion String?
  comunaNombre     String?
  costoEnvio       Float?

  fechaEntrega String?
  // Solo informativo — el pago real se coordina aparte, no hay pasarela.
  medioPago    String?

  // JSON con el detalle de productos pedidos (descripcion, corte elegido,
  // envasado, cantidad, unidad, instrucciones) — solo para mostrar, no hay
  // relación con Producto porque el catálogo puede haber cambiado para
  // cuando se revisa.
  itemsJson String

  comentario String?

  entregadoAlPos   Boolean   @default(false)
  entregadoAlPosEn DateTime?
}
