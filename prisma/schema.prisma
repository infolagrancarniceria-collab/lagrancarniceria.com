// Base de datos compartida entre la página web y el POS (lagrancarniceria-pos).
// La web es la ÚNICA pieza que toca esta base de datos directamente — el POS
// nunca se conecta acá, le habla por HTTPS a las rutas /api/sync/* de la web
// (ver src/app/api/sync/), autenticado con SYNC_API_KEY. Así, si algún día
// esa llave se filtra desde el instalador del POS, el daño posible queda
// acotado a "puede escribir catálogo/leer pedidos", nunca a la base completa.
//
// Cada sync del POS reemplaza el catálogo entero (no hace diffs) — ver
// src/app/api/sync/catalogo/route.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id     Int    @id @default(autoincrement())
  // Id del producto en el POS (Producto.id de lagrancarniceria-pos) — único
  // porque cada sync reemplaza el catálogo completo por idPos.
  idPos  Int    @unique
  plu    String
  descripcion     String
  nombreCorto     String?
  categoriaNombre String
  marca           String?
  descripcionCorta String?

  precio Float
  // "kg" (productos pesables/importe) | "unidad" (productos normales) —
  // mismo criterio que ya usa el POS (ver Producto.precio en su schema).
  unidad String

  // Familia para el selector de corte (ej. "Vacuno", "Cerdo") — null si el
  // producto no muestra selector de corte. Las opciones válidas de cada
  // familia viven en CorteOpcion.
  familiaCorte String?

  // Peso promedio de un trozo/presa, en gramos (típicamente pollo/aves) —
  // ver el mismo campo en el POS (Producto.pesoPromedioTrozoGramos) para el
  // porqué. Null = el producto no ofrece elegir por cantidad de trozos.
  pesoPromedioTrozoGramos Int?

  // "disponible" | "agotado" | "proximamente" — string en vez de un enum de
  // Postgres para no tener que migrar el enum cada vez que el POS agregue
  // un estado nuevo (mismo criterio que usa el POS para sus campos libres).
  disponibilidad String  @default("disponible")
  featured        Boolean @default(false)
  lowStock        Boolean @default(false)

  // Promoción por volumen (ej. "$3.980/kg al llevar 3 kilos o más") — los
  // tres campos van juntos: si promoPrecioUnitario tiene valor, la tarjeta
  // de producto muestra el badge "Oferta" y la etiqueta.
  promoPrecioUnitario Float?
  promoGramosMinimos  Int?
  promoEtiqueta       String?

  // Opciones de preparación por unidad (ej. "Entero,Trozado,Para la
  // parrilla") — solo para productos por unidad. Si tiene valor, el
  // cotizador pide una elección independiente por cada unidad pedida (ej.
  // 3 pollos enteros: 2 "Entero" y 1 "Para la parrilla") en vez de una sola
  // elección para todo el pedido. Lista separada por comas, sin tabla
  // aparte (a diferencia de CorteOpcion/familiaCorte, que son por familia
  // de corte para productos por peso) porque es específico de este
  // producto, no compartido entre varios.
  opcionesUnidad String?

  actualizadoEn DateTime @updatedAt
}

model Comuna {
  id         Int    @id @default(autoincrement())
  nombre     String @unique
  costoEnvio Float

  actualizadoEn DateTime @updatedAt
}

model CorteOpcion {
  id      Int    @id @default(autoincrement())
  familia String
  nombre  String
  orden   Int    @default(0)

  @@unique([familia, nombre])
}

// Pedido armado por un cliente en la web (cotización, no un pago) — el POS
// lo trae mediante /api/sync/pedidos-pendientes y lo marca "entregadoAlPos"
// al confirmar que quedó guardado ahí (ver /api/sync/pedidos-confirmar),
// para no reenviarlo de nuevo.
model Pedido {
  id    String   @id @default(cuid())
  fecha DateTime @default(now())

  clienteNombre   String
  clienteTelefono String

  // "retiro" | "despacho" — clienteDireccion/comunaNombre/costoEnvio solo
  // aplican (y son obligatorios en la validación de /api/pedidos) cuando es
  // despacho; en un retiro en tienda quedan null. El default solo importa
  // para la migración (filas existentes, si las hubiera) — todo pedido
  // nuevo siempre lo manda explícito.
  tipoEntrega      String  @default("despacho")
  clienteDireccion String?
  comunaNombre     String?
  costoEnvio       Float?

  fechaEntrega String?
  // Solo informativo — el pago real se coordina aparte, no hay pasarela.
  medioPago    String?

  // JSON con el detalle de productos pedidos (descripcion, corte elegido,
  // envasado, cantidad, unidad, instrucciones) — solo para mostrar, no hay
  // relación con Producto porque el catálogo puede haber cambiado para
  // cuando se revisa.
  itemsJson String

  comentario String?

  entregadoAlPos   Boolean   @default(false)
  entregadoAlPosEn DateTime?
}

// ---------------------------------------------------------------------------
// Etiquetado nutricional de productos artesanales (módulo /etiquetado,
// protegido con ETIQUETADO_CLAVE). Independiente del catálogo sincronizado
// desde el POS: el sync borra y recrea Producto entero, así que el vínculo
// con la web va por idPos (estable), nunca por Producto.id.
// Cálculos: src/lib/etiquetado/calculo.ts (Manual MINSAL 2017).
// ---------------------------------------------------------------------------

// Ingrediente con su composición por 100 g (o 100 ml × densidad) — fuente
// por defecto USDA FoodData Central (SR Legacy), editable.
model IngredienteNutricional {
  id           Int     @id @default(autoincrement())
  nombre       String  @unique
  // Cómo aparece en el listado de ingredientes del rótulo (ej. "sal de cura
  // (sal, nitrito de sodio)").
  nombreRotulo String
  fuente       String
  notas        String?

  energiaKcal  Float
  proteinasG   Float
  grasaTotalG  Float
  grasaSatG    Float
  grasaMonoG   Float
  grasaPoliG   Float
  grasaTransG  Float
  colesterolMg Float
  hcDispG      Float
  azucaresG    Float
  sodioMg      Float

  // Anexo 2 del manual — si agregar este ingrediente cuenta como "adición"
  // del nutriente crítico (sin adición no hay sello).
  adicionaSodio    Boolean @default(false)
  adicionaAzucares Boolean @default(false)
  adicionaGrasas   Boolean @default(false)

  // g de agua por 100 g (USDA "Water"): la sal de la salmuera entra en el
  // agua del tejido. Null = se estima por diferencia.
  aguaG       Float?
  densidadGMl Float   @default(1)
  pesoUnidadG Float?
  // Lista separada por comas (ej. "leche, soya") — vacío si no es alérgeno.
  alergeno    String?

  itemsReceta   RecetaItem[]
  actualizadoEn DateTime     @updatedAt
}

model ProductoArtesanal {
  id     Int    @id @default(autoincrement())
  // Nombre del alimento tal como va en el rótulo.
  nombre String @unique

  // La receta se ingresa como "X kg de base" + cantidades por kg de base
  // (o totales) — ver RecetaItem.porKgBase.
  kgBase   Float
  // Merma típica del proceso (%) — se usa si la etiqueta no elige un lote.
  mermaPct Float @default(0)
  // Salmuera que queda en la carne (% del peso de la base): inyectado +
  // ganancia por inmersión. Null si el producto no lleva salmuera.
  salmueraAbsorbidaPct Float?

  // Curado por inmersión, modelo de equilibrio (src/lib/etiquetado/calculo.ts):
  // si curadoActivo, reemplaza a salmueraAbsorbidaPct.
  curadoActivo    Boolean @default(false)
  tandaLitros     Float?
  tandaKgCarne    Float?
  // Agua promedio (%) de la carne de toda la tanda (productos mezclados).
  tandaAguaCarnePct Float @default(65)
  fraccionEqMin   Float?
  fraccionEqMax   Float?
  factorAzucarMin Float   @default(0.5)
  factorAzucarMax Float   @default(0.7)
  enjuaguePct     Float   @default(5)
  // "si" | "no" | "pendiente" — pendiente = el rango considera ambas.
  inyeccion       String  @default("no")
  inyeccionPct    Float   @default(10)
  // Rango de merma mientras no haya lotes medidos (el central es mermaPct).
  mermaMinPct     Float?
  mermaMaxPct     Float?
  // % de la merma que es grasa que gotea (tocino, costillar).
  mermaGrasaPct   Float   @default(0)
  // % de hueso tal como se vende; la tabla es por parte comestible salvo
  // que tablaConHueso sea true.
  huesoPct        Float   @default(0)
  tablaConHueso   Boolean @default(false)
  // JSON { parametro: "confirmado" | "supuesto" } — hoja de supuestos.
  supuestos       String?

  porcionG            Float
  porcionMedidaCasera String @default("1 unidad")

  vidaUtilDias     Int?
  almacenamiento   String?
  instruccionesUso String?
  // Texto libre extra en el rótulo (ej. "Puede contener trazas de ...").
  leyendaAdicional String?

  // Medidas de la cara principal de la etiqueta, para el tamaño del sello.
  etiquetaAnchoCm Float?
  etiquetaAltoCm  Float?
  // true = sellos "ALTO EN" en columna (uno bajo otro) en vez de la
  // disposición del Anexo 3 (de a dos por fila / en una fila).
  sellosVertical  Boolean @default(false)

  // Diseño propio de la cara principal (imagen hecha en Canva, guardada en
  // Vercel Blob). Si existe, la etiqueta lo usa de fondo y encima pone los
  // sellos (cuadrante superior derecho) y los campos variables.
  disenoFrontalUrl String?
  // JSON con la posición de cada campo variable sobre el diseño, en % del
  // ancho/alto: {"neto":{"x":16,"y":94},"elab":…,"venc":…,"lote":…}. Cada
  // punto es el inicio del texto, apoyado sobre la línea.
  disenoCampos     String?

  // Producto del catálogo web (Producto.idPos) donde publicar la tabla.
  idPosWeb      Int?
  publicarEnWeb Boolean @default(false)

  items RecetaItem[]
  lotes LoteProduccion[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model RecetaItem {
  id            Int                    @id @default(autoincrement())
  productoId    Int
  producto      ProductoArtesanal      @relation(fields: [productoId], references: [id], onDelete: Cascade)
  ingredienteId Int
  ingrediente   IngredienteNutricional @relation(fields: [ingredienteId], references: [id], onDelete: Restrict)
  cantidad      Float
  // "g" | "kg" | "ml" | "l" | "unidad"
  unidad        String
  porKgBase     Boolean                @default(true)
  // Ingrediente de la salmuera: define su composición; al producto entra
  // solo lo absorbido (ProductoArtesanal.salmueraAbsorbidaPct).
  enSalmuera    Boolean                @default(false)
  orden         Int                    @default(0)

  @@index([productoId])
}

// Lote real producido — guarda la merma medida (peso antes/después del
// proceso) para que la etiqueta use el valor real de ese lote.
model LoteProduccion {
  id               Int               @id @default(autoincrement())
  productoId       Int
  producto         ProductoArtesanal @relation(fields: [productoId], references: [id], onDelete: Cascade)
  codigo           String
  fechaElaboracion DateTime
  // Null = se calcula con vidaUtilDias del producto.
  fechaVencimiento DateTime?
  pesoAntesG       Float
  pesoFinalG       Float
  notas            String?
  creadoEn         DateTime          @default(now())

  @@unique([productoId, codigo])
  @@index([productoId])
}

// Datos de rotulación general (fila única, id = 1).
model DatosRotulo {
  id                  Int     @id @default(1)
  razonSocial         String
  domicilio           String
  resolucionSanitaria String
  paisOrigen          String  @default("Chile")
  contacto            String?
}

// Foto de producto subida desde /etiquetado/fotos (guardada en Vercel
// Blob). Por idPos —no Producto.id— porque el sync del POS recrea el
// catálogo entero. Si existe, reemplaza a la foto asignada por reglas en
// src/lib/imagenesProductos.ts.
model FotoProducto {
  idPos         Int      @id
  url           String
  actualizadoEn DateTime @updatedAt
}
